# Phase 4 — the optional phrasing pass. Everything works without any of this.
#
# The deterministic composer produces the entire structured answer with no key
# and no network. The model only rewrites prose, and anything it adds that was
# not in the fetched data is rejected outright. See app/llm.py.
#
# Copy to `.env` (which is gitignored) and fill in ONE provider below.

# ---------------------------------------------------------------------------
# Provider. Any OpenAI-compatible gateway works — swapping is these two lines.
# ---------------------------------------------------------------------------
#
#   NVIDIA NIM     https://integrate.api.nvidia.com/v1
#                  38 free endpoints, 40 rpm, no card. Key from
#                  build.nvidia.com -> API Keys. Recommended.
#                  Models: deepseek-ai/deepseek-v4-flash, moonshotai/kimi-k3
#
#   OpenCode Zen   https://opencode.ai/zen/v1
#                  Free tier, no card. Note muse-spark-*-contributor-free
#                  currently returns HTTP 500 for accounts that have not
#                  accepted Meta's contributor terms.
#
#   Groq           https://api.groq.com/openai/v1
#   OpenRouter     https://openrouter.ai/api/v1
#   xAI            https://api.x.ai/v1        (separate from a SuperGrok sub)
#   Ollama         http://localhost:11434/v1  (fully offline, no key needed)

LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=deepseek-ai/deepseek-v4-flash
LLM_API_KEY=

# Tried in order if the primary model errors, so a provider-side outage costs
# one extra request rather than the whole phrasing pass. Comma separated.
LLM_FALLBACK_MODELS=

LLM_ENABLED=true
LLM_TIMEOUT_S=8
LLM_MAX_TOKENS=700

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
# Who may call this service directly. In the normal deployment only the Node
# API does, so the default is deliberately tight.
AI_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
AI_HOST=127.0.0.1
AI_PORT=8000
