# ============================================================================
#  WeatherGPT API — environment
#
#  Only TWO values are required, and neither costs anything:
#    MONGO_URI    a database (local install, or a free MongoDB Atlas cluster)
#    JWT_SECRET   a random string you generate yourself
#
#  Everything else has a working default. No weather API key. No warning API
#  key. No geocoding key. See SETUP.md for where each free service comes from.
# ============================================================================

NODE_ENV=development
# 5050, not 5000: macOS binds 5000 (and 7000) to the AirPlay Receiver, so the
# obvious default fails on every recent Mac with an error that explains nothing.
PORT=5050
LOG_LEVEL=info

# Comma-separated. Add your deployed frontend origin before going live.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- REQUIRED --
# Local:  mongodb://127.0.0.1:27017/weathergpt
# Atlas:  mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/weathergpt?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/weathergpt

# Generate with:  openssl rand -hex 32      (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Must be at least 32 characters. Never commit the real value.
JWT_SECRET=
JWT_EXPIRY=7d

# ------------------------------------------------------- FORECAST (free) ----
# Open-Meteo. No key, no signup, no card. Non-commercial use is free.
OPEN_METEO_BASE=https://api.open-meteo.com/v1
# Models compared to produce the confidence score. Rename here if Open-Meteo
# ever changes an identifier — nothing else in the codebase hardcodes them.
ENSEMBLE_MODELS=ecmwf_ifs025,ncep_gfs_seamless,dwd_icon_seamless
FORECAST_TTL_MINUTES=30

# ----------------------------------------- OFFICIAL WARNINGS (free, public) --
# NDMA Sachet publishes CAP alerts from IMD, CWC and all state authorities.
#
# This path is load-bearing. The older /CapFeed returns an HTML page which
# parses to zero alerts and falls through to the bundled samples — and the
# pipeline reports ok:true the whole way, so every health check stays green
# while the app shows fabricated warnings. Check `fetched` in the ingest
# result, not just `ok`:  npm run warnings:once
SACHET_CAP_FEED=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
CAP_FEED_ENABLED=true
# If the live feed is unreachable, fall back to data/sample-alerts.xml so the
# pipeline still demonstrates. Turn this OFF in production.
CAP_FALLBACK_TO_SAMPLES=true

# ------------------------------------------------------ GEOCODING (free) ----
# Nominatim: no key, but a real contact address in the User-Agent is required
# by their usage policy, and requests are limited to one per second.
NOMINATIM_BASE=https://nominatim.openstreetmap.org
CONTACT_EMAIL=your-team-email@example.com

# ------------------------------------------------- PHASE 3 RISK ENGINE ------
PYTHON_AI_URL=http://127.0.0.1:8000

# ------------------------------------------------------------- SCHEDULES ----
JOBS_ENABLED=true
CRON_WARNINGS=*/5 * * * *
CRON_EXPIRE=*/5 * * * *

# --- push notifications ----------------------------------------------------
# Free, no account. Generate a keypair once and keep it stable — rotating it
# invalidates every existing browser subscription:
#
#     npx web-push generate-vapid-keys
#
# Leave both blank and push disables itself cleanly; /api/health says so, and
# the alert cron is not scheduled at all rather than failing every five minutes.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Offset from CRON_WARNINGS so the fan-out reads warnings that have just landed
# rather than racing the run that is storing them.
CRON_ALERTS=2-59/5 * * * *

# ── optional: the agriculture image models (PRD §7, §8) ────────────────────
# One free read token covers both:  https://huggingface.co/settings/tokens
# Blank disables Crop Doctor and Soil Check cleanly — the screens say a model
# is not connected and offer no verdict. They never invent a class.
HF_TOKEN=

# ── optional: the prose layer (PRD §10) ────────────────────────────────────
# https://aistudio.google.com/apikey  — the free tier is generous.
# Blank changes how well answers read, never what they say: the deterministic
# composer produces the whole structured response either way, and each answer
# says "phrased locally" or "phrased by Gemini" in its own footer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
