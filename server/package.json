{
  "name": "weathergpt-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "WeatherGPT API \u2014 Phase 2 data floor. Forecasts, official CAP warnings, locations.",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seedGazetteer.js",
    "warnings:once": "node scripts/runWarningsOnce.js",
    "smoke": "node scripts/smoke.js",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test tests/e2e.*.test.mjs",
    "dev:nodb": "node scripts/devStandalone.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "fast-xml-parser": "^4.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "multer": "^2.3.0",
    "node-cron": "^3.0.3",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4"
  }
}
